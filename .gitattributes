# The guard files are hash-pinned in hooks/secrets-guard.manifest.json (LF-normalized). Keep them LF
# on every platform so a Windows checkout installs and verifies the exact reviewed bytes.
hooks/*.js text eol=lf
hooks/*.mjs text eol=lf
hooks/*.json text eol=lf

# The Workforce bridge verifies the retained installer by hashing its files as checked out
# (frozen_family.verify_engine). Those hashes are LF bytes, so every text file must check out
# LF on Windows as well, or a Windows student fails verification on start.sh before anything runs.
* text=auto eol=lf
